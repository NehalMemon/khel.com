# Required — Supabase project (Auth + Postgres). Without these the app boots
# but `/partner/*`, `/admin/*`, `/bookings` and `/profile` bounce to their
# sign-in pages, and sign-in shows the "configure Supabase" notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — canonical origin used for absolute links / OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
