# Required — Supabase project (Auth + Postgres). Without these the app boots
# but `/partner/*`, `/admin/*`, `/bookings` and `/profile` bounce to their
# sign-in pages, and sign-in shows the "configure Supabase" notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — canonical origin used for absolute links / OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Safepay checkout. `NEXT_PUBLIC_SAFEPAY_PUBLIC_KEY` is your Safepay *public*
# key (safe to expose in the browser); leave it blank to render the checkout
# button disabled. NEVER put a Safepay secret key in the frontend.
NEXT_PUBLIC_SAFEPAY_PUBLIC_KEY=
# One of: sandbox | production
NEXT_PUBLIC_SAFEPAY_ENV=sandbox
